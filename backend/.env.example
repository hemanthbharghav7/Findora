# ─────────────────────────────────────────────────────
# .env.example – Findora Backend Environment Variables
# ─────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file to version control.
# ─────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local:  mongodb://localhost:27017/findora
# Atlas:  mongodb+srv://<user>:<db_password>@<cluster>.mongodb.net/findora
MONGO_URI=mongodb+srv://<YOUR_DB_USER>:<YOUR_DB_PASSWORD>@<YOUR_CLUSTER>.mongodb.net/findora?retryWrites=true&w=majority&appName=FINDORA

# JWT
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRES_IN=7d

# Frontend origin (used to restrict CORS in production)
FRONTEND_URL=http://localhost:5173
